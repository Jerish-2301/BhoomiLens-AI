# ──────────────────────────────────────────
# BhoomiLens — Git Ignore Rules
# ──────────────────────────────────────────

# 🔐 NEVER commit environment files (contain API keys!)
.env
.env.local
.env.*.local
apps/web/.env
apps/api/.env
apps/**/.env

# Dependencies
node_modules/
**/node_modules/

# Build outputs
dist/
build/
**/dist/
**/build/
.next/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Editor / OS
.DS_Store
Thumbs.db
.vscode/settings.json
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Firebase emulator data
.firebase/
firebase-debug.log
firestore-debug.log
ui-debug.log
